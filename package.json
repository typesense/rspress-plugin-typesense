{
  "name": "rspress-plugin-typesense",
  "description": "A plugin that adds lightning-fast, typo-tolerant, Typesense-powered search to your Rspress site",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit",
    "test:integration": "rstest"
  },
  "devDependencies": {
    "@rslib/core": "^0.20.1",
    "@rstest/core": "0.11.11",
    "@types/node": "^24.12.0",
    "rsbuild-plugin-publint": "^0.3.4",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@rspress/core": "^2.0.8"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "typesense": "^3.0.6",
    "typesense-docsearch-css": "5.0.2-0",
    "typesense-docsearch-react": "5.0.2-0"
  },
  "keywords": [
    "typesense",
    "documentation-search",
    "search",
    "rspress-plugin",
    "rspress",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typesense/rspress-plugin-typesense.git"
  },
  "bugs": "https://github.com/typesense/rspress-plugin-typesense/issues",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
